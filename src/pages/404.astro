  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-32 text-center">
    <h1 class="font-serif text-6xl text-fg">404</h1>
    <p class="mt-4 text-muted">这个页面好像走丢了。</p>
    <a href="/" class="mt-8 border border-white/15 px-6 py-2 text-fg transition-colors hover:border-accent hover:text-accent">
      回到首页
    </a>
  </section>
</BaseLayout>
