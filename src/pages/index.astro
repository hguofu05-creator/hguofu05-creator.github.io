---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { SITE } from '../consts';
import { coverPhoto, featuredPhotos, photoUrl } from '../lib/photos';

const cover = coverPhoto();
const featured = featuredPhotos(12);
---

<BaseLayout>
  <!-- ============ 全屏 Hero ============ -->
  <section class="relative flex min-h-[100svh] items-center justify-center overflow-hidden">
    <img
      src={photoUrl(cover, 1600)}
      alt={cover.title}
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <!-- 暗色压暗，保证文字可读（非彩色装饰） -->
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 px-6 text-center">
      <h1 class="font-serif text-5xl font-semibold tracking-wide text-fg sm:text-7xl">
        {SITE.name}
      </h1>
      <p class="mt-4 text-base text-muted sm:text-xl">{SITE.subtitle}</p>
      <a
        href="/gallery"
        class="mt-10 inline-block border border-white/20 px-6 py-2 text-sm text-fg transition-colors hover:border-accent hover:text-accent"
      >
        浏览作品
      </a>
    </div>
    <!-- 底部滚动提示 -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-xs text-muted">向下滚动</div>
  </section>

  <!-- ============ 精选作品瀑布流 ============ -->
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="mb-10 flex items-end justify-between">
      <h2 class="font-serif text-3xl text-fg">精选作品</h2>
      <a href="/gallery" class="text-sm text-muted transition-colors hover:text-fg">查看全部 →</a>
    </div>

    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3">
      {featured.map((p) => <PhotoCard photo={p} class="mb-4 break-inside-avoid" />)}
    </div>
  </section>
</BaseLayout>
