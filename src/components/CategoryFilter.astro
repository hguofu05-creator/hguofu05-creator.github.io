---
import { CATEGORIES } from '../lib/photos';
// 分类筛选：点击后过滤带 data-category 的卡片，并同步隐藏空分组
---

<div class="flex flex-wrap gap-2" role="tablist" aria-label="作品分类筛选">
  {
    CATEGORIES.map((c, i) => (
      <button
        type="button"
        data-filter={c.key}
        class:list={[
          'filter-btn rounded-full border px-4 py-1.5 text-sm transition-colors',
          i === 0
            ? 'border-accent text-fg'
            : 'border-white/10 text-muted hover:border-white/30 hover:text-fg',
        ]}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {c.label}
      </button>
    ))
  }
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  if (buttons.length) {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.gallery-section'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const HIDE_DELAY = reduce ? 0 : 350;

    function shouldShow(category: string, key: string) {
      return key === 'all' || (key === 'nature' && category !== 'people') || category === key;
    }

    function applyFilter(key: string) {
      // 1) 卡片显隐过渡
      cards.forEach((card) => {
        const cat = card.dataset.category || '';
        const show = shouldShow(cat, key);
        if (show) {
          card.classList.remove('display-none');
          // 强制回流，让 transition 生效
          void card.offsetWidth;
          card.classList.remove('is-hidden');
        } else {
          card.classList.add('is-hidden');
          window.setTimeout(() => card.classList.add('display-none'), HIDE_DELAY);
        }
      });

      // 2) 同步分组标题区：有可见卡片的立即显示；会变空的分组等过渡结束后隐藏
      sections.forEach((sec) => {
        const hasVisible = Array.from(sec.querySelectorAll<HTMLElement>('[data-category]')).some(
          (card) => shouldShow(card.dataset.category || '', key)
        );
        if (hasVisible) {
          sec.hidden = false;
        } else {
          window.setTimeout(() => {
            sec.hidden = true;
          }, HIDE_DELAY);
        }
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('border-accent', 'text-fg');
          b.classList.add('border-white/10', 'text-muted');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('border-accent', 'text-fg');
        btn.classList.remove('border-white/10', 'text-muted');
        btn.setAttribute('aria-pressed', 'true');
        applyFilter(btn.dataset.filter || 'all');
      });
    });
  }
</script>
